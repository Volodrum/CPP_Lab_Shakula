{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Data Source=data/app.db"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Catalog": {
    "Seed": true
  },
  "Cors": {
    "WebOrigin": "http://localhost:5090"
  }
}
